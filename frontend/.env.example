# Backend base URL used by src/api/client.js. Copy to .env to override. Not a secret.
VITE_API_BASE_URL=http://localhost:8000

# Local dev / tests: leave VITE_API_BASE_URL unset to reach the local default http://localhost:8000.
# Production (TS-11): the build uses frontend/.env.production, which sets VITE_API_BASE_URL= (empty)
# for a same-origin relative API base, because FastAPI serves the React build on the same origin.

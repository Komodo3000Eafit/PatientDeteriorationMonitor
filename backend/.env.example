# Copy to backend/.env (git-ignored) and fill in real values. Never commit backend/.env.
# Neon pooled connection string (Neon console > Connect); required for the database.
DATABASE_URL=postgresql://<user>:<password>@<host>/neondb?sslmode=require
# Allowed frontend origins, comma-separated; '*' is not allowed (default http://localhost:5173).
CORS_ORIGINS=http://localhost:5173
# Required secret that signs the access tokens, at least 32 random characters.
AUTH_SECRET=<generate: python -c "import secrets; print(secrets.token_urlsafe(48))">
# Access token lifetime in minutes, a whole number from 1 to 1440 (default 480).
ACCESS_TOKEN_MINUTES=480
# Password for demo.doctor, used only by python -m app.seed_demo_users.
DEMO_DOCTOR_PASSWORD=<at least 8 characters>
# Password for demo.nurse, used only by python -m app.seed_demo_users.
DEMO_NURSE_PASSWORD=<at least 8 characters>
